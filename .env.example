# Copie para .env (não versionado). Valores abaixo são só de exemplo.

# Banco
DB_URL=jdbc:postgresql://localhost:5432/kjfleets
DB_USER=postgres
DB_PASSWORD=troque-esta-senha

# Segurança
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

# Roteirização
ROUTING_MODE=haversine
ROUTING_DETOUR_FACTOR=1.3
ROUTING_AVG_SPEED_KMH=40
