# Copie para .env (não versionado). Valores abaixo são só de exemplo.

# Banco
DB_URL=jdbc:postgresql://localhost:5432/kjfleets
DB_USER=postgres
DB_PASSWORD=troque-esta-senha

# Segurança
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

# Roteirização
ROUTING_MODE=haversine
ROUTING_DETOUR_FACTOR=1.3
ROUTING_AVG_SPEED_KMH=40
ROUTING_ARRIVAL_RADIUS_M=200
ROUTING_POSITION_MAX_AGE_S=300
# Só no modo road:
# ROUTING_GRAPH_NODES=./data/nodes.csv
# ROUTING_GRAPH_EDGES=./data/edges.csv

# Dashboard
DASHBOARD_TIMEZONE=America/Sao_Paulo
DASHBOARD_STALE_UNASSIGNED_MIN=30
DASHBOARD_STALE_ASSIGNED_MIN=15
DASHBOARD_STALE_DISPATCHED_MIN=15
DASHBOARD_STALE_ENROUTE_MIN=60
DASHBOARD_STALE_ARRIVED_MIN=20
DASHBOARD_STALE_IN_PROGRESS_MIN=90
DASHBOARD_MAINTENANCE_ALERT_DAYS=7
