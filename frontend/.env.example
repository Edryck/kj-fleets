# Vazio = mesma origem (em dev o Vite faz proxy para a API)
VITE_API_URL=
# Vazio = derivada da localização atual (/ws)
VITE_WS_URL=
# Só desenvolvimento: destino do proxy do Vite (a porta que a API publica)
VITE_PROXY_TARGET=
# Só desenvolvimento: logins de teste, JSON. Não commite valores reais
VITE_DEV_LOGINS=
