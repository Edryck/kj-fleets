#!/bin/sh
pattern='co-authored-by:.*(claude|anthropic)|generated (with|by).*claude|noreply@anthropic\.com'
zero=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    commits=$(git rev-list "$local_sha" --not --remotes)
  else
    commits=$(git rev-list "$remote_sha..$local_sha")
  fi

  for commit in $commits; do
    if git log -1 --format='%an%n%ae%n%cn%n%ce%n%B' "$commit" | grep -qiE "$pattern"; then
      echo "Push bloqueado: o commit $commit tem atribuição ao Claude." >&2
      exit 1
    fi
  done
done
