  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminUser",
      "value": "admin"
    },
    {
      "key": "adminPass",
      "value": "troque-esta-senha"
    },
    {
      "key": "driverUser",
      "value": "joao"
    },
    {
      "key": "driverPass",
      "value": "troque-esta-senha"
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "driverId",
      "value": ""
    },
    {
      "key": "vehicleId",
      "value": ""
    },
    {
      "key": "fleetId",
      "value": ""
    },
    {
      "key": "placeId",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "trackingNumber",
      "value": ""
    },
    {
      "key": "stopSeq",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth e usuários",
      "item": [
        {
          "name": "Registrar cliente",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"cliente1\",\n  \"password\": \"troque-esta-senha\",\n  \"name\": \"Cliente Um\",\n  \"phone\": \"45999990000\",\n  \"email\": \"cliente1@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUser}}\",\n  \"password\": \"{{adminPass}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// guarda o token para as outras requisições",
                  "const body = pm.response.json();",
                  "if (body.token) pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar usuário de equipe",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"operador1\",\n  \"password\": \"troque-esta-senha\",\n  \"role\": \"DISPATCHER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Listar usuários",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Listar clientes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customers?limit=20&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Só leitura. Guarda o primeiro cliente em customerId para o Criar pedido."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.items && body.items[0]) pm.collectionVariables.set('customerId', body.items[0].publicId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar pedido",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"pickup\": {\n    \"placeId\": \"{{placeId}}\"\n  },\n  \"dropoff\": {\n    \"name\": \"Casa Ana\",\n    \"address\": \"Rua B, 20\",\n    \"lat\": -24.87,\n    \"lng\": -54.33\n  },\n  \"waypoints\": [\n    {\n      \"placeId\": \"{{placeId}}\"\n    }\n  ],\n  \"items\": [\n    {\n      \"name\": \"Caixa P\",\n      \"quantity\": 2\n    }\n  ],\n  \"podRequired\": true,\n  \"notes\": \"Interfone 12\",\n  \"meta\": {\n    \"externalRef\": \"PED-991\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Lugar novo vai no ponto (name, address, lat, lng) e lugar existente vai como placeId; nunca os dois no mesmo ponto. Equipe pode omitir customerId (o pedido fica sem dono). Cliente logado é o dono, e o customerId é ignorado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.publicId) pm.collectionVariables.set('orderId', body.publicId);",
                  "if (body.trackingNumber) pm.collectionVariables.set('trackingNumber', body.trackingNumber);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar pedidos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders?status=CREATED&limit=20&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "CREATED"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "Detalhar pedido",
          "request": {
            "method": "GET",
            "header": [],
