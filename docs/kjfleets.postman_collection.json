                }
              }
            }
          }
        },
        {
          "name": "Calcular rota",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/route",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "route"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"algorithm\": \"HELD_KARP\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Recalcula e substitui a rota gravada, mantendo as paradas concluídas. Sem corpo, usa o padrão (HELD_KARP até 15 waypoints pendentes, senão TWO_OPT). Pedido terminal responde 422."
          }
        },
        {
          "name": "Ver rota gravada",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/route",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "route"
              ]
            },
            "description": "Paradas, totais e etaMinutes vivo (recalculado a cada leitura). 404 ROUTE_NOT_FOUND se o pedido ainda não tem rota."
          }
        },
        {
          "name": "Concluir parada (equipe)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/stops/{{stopSeq}}/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "stops",
                "{{stopSeq}}",
                "complete"
              ]
            },
            "description": "Conclui uma parada WAYPOINT (stopSeq) sem checagem de distância. Se o motorista tiver posição recente, grava distanceM. PICKUP e DROPOFF não passam por aqui (use activity). Repetir não muda nada."
          }
        }
